{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth purpose string, shown the first time the user taps Scan.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث عن أجهزة opensensor القريبة منك ويتصل بها لنسخ قراءاتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds and connects to your opensensor devices nearby to copy their readings."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Camera purpose string, shown the first time the user taps Scan on the sensor sticker card.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ الرمز الشريطي على ملصق المستشعر. لا تُحفظ أي صورة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the barcode on your sensor sticker. No picture is kept."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network purpose string, shown when the app first looks for sensors on Wi-Fi.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث عن أجهزة opensensor على شبكة Wi-Fi لديك لمزامنة أسرع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds your opensensor devices on your Wi-Fi to sync faster."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Foreground approximate location, requested only by Near me or Use phone location for a sensor.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع الخريطة بالقرب منك أو يحدد منطقة تقريبية للمستشعر عند طلبك. تُرسل المنطقة التي تختارها فقط إلى مستشعرك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centres the public map or sets an approximate sensor area when you ask. Only the selected area is sent to your sensor."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
