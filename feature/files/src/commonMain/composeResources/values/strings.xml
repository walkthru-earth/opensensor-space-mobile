<?xml version="1.0" encoding="utf-8"?>
<!--
  Files and file inspector copy for Android and iOS, one catalogue (docs/screens.md, Files).
  Keys and words match the Android strings.xml they came from. No em or en dashes, no colons
  or semicolons. Compose resources keep a plain apostrophe, there is no backslash escape here.
-->
