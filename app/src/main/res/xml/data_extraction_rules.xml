<?xml version="1.0" encoding="utf-8"?>
<!--
  What leaves the phone through Android's own backup paths (minSdk 31, so this file is the only one
  that applies; `fullBackupContent` is ignored from Android 12).

  Cloud backup excludes the entire Room database because known_device contains the LAN bearer token.
  Android extraction rules cannot select or redact individual database rows/columns, so including the
  database would disclose that token and future device secrets to the backup payload. Preferences are
  intentionally included; they contain UI settings only. The archive is also excluded from cloud
  backup because it is reproducible from the logger and commonly exceeds Auto Backup's 25 MB quota.

  Device-to-device transfer (cable / local Wi-Fi, no server) carries the archive and database so a
  user-initiated local migration retains history. Keystore keys are device-bound, so LAN access may
  require fetching the token again over Bluetooth on the destination. Partial downloads in
  `archive-partial/` and encryption key material in `noBackupFilesDir` are never included.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="archive/" />
        <include domain="database" path="aq-sync.db" />
    </device-transfer>
</data-extraction-rules>
