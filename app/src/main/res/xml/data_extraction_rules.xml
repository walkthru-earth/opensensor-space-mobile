<?xml version="1.0" encoding="utf-8"?>
<!--
  What leaves the phone through Android's own backup paths (minSdk 31, so this file is the only one
  that applies; `fullBackupContent` is ignored from Android 12). Once a section has an include,
  only the included paths leave the phone.

  Settings travel. They are the two Preferences DataStore files, `files/datastore/settings.preferences_pb`
  (AppSettings, UI choices only) and `files/datastore/discover.preferences_pb` (DiscoverStore, last
  map camera, property, window and first-run flag, never a location fix).

  SharedPreferences are left out on purpose. `sync_triggers` and `advert_scan` hold only runtime
  throttle state (last Wi-Fi trigger time, last advert key per device) that means nothing on
  another phone.

  Cloud backup excludes the entire Room database because known_device contains the LAN bearer token.
  Android extraction rules cannot select or redact individual database rows/columns, so including the
  database would disclose that token and future device secrets to the backup payload. The archive is
  also excluded from cloud backup because it is reproducible from the logger and commonly exceeds
  Auto Backup's 25 MB quota.

  Device-to-device transfer (cable / local Wi-Fi, no server) carries the settings, the archive, its boot clock receipts and
  the database so a user-initiated local migration retains history. Keystore keys are device-bound,
  so LAN access may require fetching the token again over Bluetooth on the destination. Partial
  downloads in `archive-partial/` and encryption key material in `noBackupFilesDir` are never included.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/discover.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/discover.preferences_pb" />
        <include domain="file" path="archive/" />
        <include domain="file" path="clock-anchors/" />
        <include domain="database" path="opensensor.db" />
    </device-transfer>
</data-extraction-rules>
