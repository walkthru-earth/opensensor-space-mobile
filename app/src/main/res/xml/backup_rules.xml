<?xml version="1.0" encoding="utf-8"?>
<!--
  Verified Parquet copies and the archive index are the user's data; let them ride along with
  device-to-device transfer and backups (both are the user's own Android account/transport, not a
  service this app talks to). Partial downloads are excluded: they are resumed from the device.
-->
<full-backup-content>
    <include domain="file" path="archive/" />
    <include domain="database" path="aq-sync.db" />
    <exclude domain="file" path="archive-partial/" />
</full-backup-content>
