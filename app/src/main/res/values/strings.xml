    <!-- Settings and the bottom bar tabs. Their copy lives in feature/settings and ui/strings composeResources, shared with iOS. -->

    <!-- On-demand permissions (permissions/RuntimeAccess.kt). Asked only from the action that needs them. -->
    <string name="perm_bt_title">Allow nearby devices</string>
    <string name="perm_bt_body">Bluetooth finds your sensors and copies their readings. It never uses your location.</string>
    <string name="perm_bt_settings_title">Nearby devices is off</string>
    <string name="perm_bt_settings_body">Turn on Nearby devices for opensensor.space in settings to connect to your sensors.</string>
    <string name="perm_lan_title">Allow local network</string>
    <string name="perm_lan_body">Finds your sensor on your Wi-Fi so syncing is faster. Bluetooth works without it.</string>
    <string name="perm_lan_settings_title">Local network is off</string>
    <string name="perm_lan_settings_body">Turn on local network access for opensensor.space in settings. Bluetooth keeps working.</string>
    <string name="perm_continue">Continue</string>
    <string name="perm_open_settings">Open settings</string>

