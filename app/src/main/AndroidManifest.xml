<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Offline-first. Bluetooth LE is the primary link: BLUETOOTH_SCAN is declared neverForLocation
      so no location permission is implied, BLUETOOTH_CONNECT for GATT.

      INTERNET exists only so that sockets exist at all: the protocol v2 LAN transport opens one
      plain TCP connection to a device discovered via mDNS `_aqsync._tcp` on the current network
      (data/lan/). The code never connects to any address it did not obtain from that discovery;
      there is still no cloud endpoint, no analytics and no account. A future cloud step needs its
      own explicit opt-in setting and review (AGENTS.md).

      ACCESS_LOCAL_NETWORK (API 37+) is required for any local-network traffic — TCP, mDNS,
      NsdManager — on phones targeting SDK 37. It is in the NEARBY_DEVICES group with the Bluetooth
      permissions, so it is usually granted with them; the app still checks and requests it before
      any LAN action and keeps working over Bluetooth when it is denied. Below API 37 the permission
      does not exist and is never requested.

      FOREGROUND_SERVICE + FOREGROUND_SERVICE_DATA_SYNC: every file transfer runs under a `dataSync`
      foreground service (data/background/SyncForegroundService). Measured on Android 16 (OnePlus 7 Pro): ~2 min after the screen
      went off, ConnectivityService "Destroyed live tcp sockets for uids={<ours>}" and the LAN sync
      died with "Software caused connection abort" — the background network restriction. A
      foreground service keeps the uid out of that firewall chain for the duration of the transfer
      and not a second longer. POST_NOTIFICATIONS is requested at runtime on API 33+ so the progress
      notification is visible; a denial only hides the notification, the service still runs.
      The auto-sync WorkManager worker (data/background/SyncWorker) uses the same type through
      WorkManager's SystemForegroundService, merged below.

      WAKE_LOCK exists for exactly one object: the WifiManager.WifiLock in data/lan/LanWifiLock,
      held only while a file transfer runs over the LAN pipe (measured 2026-09-17: with the screen
      locked the phone's Wi-Fi entered power save, throughput fell 5x and TCP stalled). The app
      holds no CPU wake lock; Bluetooth syncs hold nothing.

      Companion Device Manager ("wake when nearby", data/background/CompanionPresence*): the user
      approves one system dialog per logger; Android then scans for that Bluetooth address itself
      and binds CompanionPresenceService while the logger is in range. The four REQUEST_COMPANION_*
      permissions are normal (install-time) and only take effect while an associated device is
      present (AOSP CompanionExemptionProcessor): RUN_IN_BACKGROUND puts the app on the power-save
      allowlist, USE_DATA_IN_BACKGROUND allows background data — the exemption the measured
      screen-off socket kill called for — START_FOREGROUND_SERVICES_FROM_BACKGROUND lets the worker's
      setForeground succeed when the trigger fires with the app closed, and
      OBSERVE_COMPANION_DEVICE_PRESENCE is required by startObservingDevicePresence. No location
      permission is involved. RECEIVE_BOOT_COMPLETED only restarts the process so the Wi-Fi-arrival
      trigger (data/background/SyncTriggers) is re-registered; it schedules nothing by itself.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <application
        android:name=".AqSyncApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AqSync"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AqSync"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the process out of the background firewall chain while a user-started sync runs.
          Started by DeviceConnectionRepository when a transfer begins (the app is in the
          foreground at that moment); it attaches to the repository's sync state flow, shows the
          progress notification with a Stop action, and stops itself when the sync ends.
        -->
        <service
            android:name=".data.background.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Auto-sync (data/background/SyncWorker, AutoSyncScheduler). WorkManager's own foreground
          service carries the worker's progress notification; it must be declared with the same
          dataSync type as ours, otherwise Android 14+ refuses setForeground. The default WorkManager
          initializer is removed so the Application can supply the Hilt worker factory.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Bound by the system while an associated logger is in Bluetooth range (Companion Device
          Manager); enqueues the auto-sync worker for that device. Exported with the framework's
          signature permission, as the API requires.
        -->
        <service
            android:name=".data.background.CompanionPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- Explicit target of the Wi-Fi-arrival PendingIntent (SyncTriggers); never exported. -->
        <receiver
            android:name=".data.background.WifiArrivalReceiver"
            android:exported="false" />

        <!--
          Explicit target of the offloaded BLE scan PendingIntent (AdvertFlagScan): the controller
          wakes the app when a bonded Auto-sync logger advertises new_files / no_utc. Never exported.
        -->
        <receiver
            android:name=".data.background.AdvertScanReceiver"
            android:exported="false" />

        <!-- Starts the process after boot/update so Application.onCreate re-arms the triggers. -->
        <receiver
            android:name=".data.background.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Read-only handout of archive files and export zips to the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
