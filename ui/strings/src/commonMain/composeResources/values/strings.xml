<?xml version="1.0" encoding="utf-8"?>
<!--
  The shared English copy for the iOS companion screen and the shared screens to come, one catalogue
  for Android and iOS. Copy rules (docs/screens.md, CopyLintTest). No em or en dashes, no colons or
  semicolons. Compose resources keep a plain apostrophe, there is no backslash escape here.
  A key that Android res/values/strings.xml already has keeps its name and its exact words
  (StringsMatchAndroidTest).
-->
<resources>
    <!-- Same keys and words as Android. -->
    <string name="app_name">opensensor.space</string>
    <string name="now_waiting">Waiting for a reading…</string>
    <string name="nav_disconnect">Disconnect</string>
