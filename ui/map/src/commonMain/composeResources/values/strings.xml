<?xml version="1.0" encoding="utf-8"?>
<!--
  Map control copy for Android and iOS, one catalogue for every screen with a map (ui:map). Copy
  rules (docs/screens.md, CopyLintTest). No em or en dashes, no colons or semicolons.
-->
<resources>
    <!-- The zoom buttons, spoken only. -->
    <string name="map_zoom_in">Zoom in</string>
    <string name="map_zoom_out">Zoom out</string>
    <!-- The Near me button, spoken only, and its miss, shown and announced. -->
    <string name="map_near_me">Near me</string>
    <string name="map_near_me_none">Location not found</string>
    <!-- Near me's location dialogs. The rationale shows only when Android says it is due. -->
    <string name="map_near_me_access_title">Allow approximate location</string>
    <string name="map_near_me_access_body">Near me moves the map to your area. Your location stays on this phone.</string>
    <string name="map_near_me_settings_title">Location is off</string>
    <string name="map_near_me_settings_body">Turn on location for opensensor.space in your phone settings to use Near me.</string>
    <string name="map_access_continue">Continue</string>
    <string name="map_access_not_now">Not now</string>
    <string name="map_access_open_settings">Open settings</string>
    <string name="map_access_cancel">Cancel</string>
    <!-- Place search over the bundled GeoNames list. Picking a place only moves the map. -->
    <string name="map_search_places">Search places</string>
    <string name="map_search_clear">Clear search</string>
    <string name="map_no_places">No matching places</string>
    <!-- The area picker of setup and Device settings. -->
    <string name="map_picker_label">Map of areas. Tap an area to choose it</string>
    <string name="map_pick_zoom_in">Zoom in to pick an area</string>
    <string name="map_pick_middle">Choose the area in the middle</string>
    <string name="map_picker_selected">Chosen area</string>
    <string name="map_picker_unavailable">The area map is not available on this phone</string>
    <!-- The picker's map credits, in its info sheet. The OpenStreetMap lines show only while the basemap may load. -->
    <string name="map_osm">© OpenStreetMap</string>
    <string name="map_info_title">Map data</string>
    <string name="map_info_osm">Map data © OpenStreetMap contributors, under the Open Database License. See openstreetmap.org/copyright.</string>
    <string name="map_info_protomaps">Basemap by Protomaps.</string>
    <string name="map_info_geonames">Place names © GeoNames, under CC BY 4.0. See geonames.org.</string>
    <string name="map_info_grid">Each outline is one area of about 0.74 km². Only the area you choose is sent to the sensor.</string>
</resources>
