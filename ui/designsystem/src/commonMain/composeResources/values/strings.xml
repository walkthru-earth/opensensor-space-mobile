<?xml version="1.0" encoding="utf-8"?>
<!-- Copy owned by the shared components. Plain words, no long dashes, colons or semicolons. -->
<resources>
    <!-- InfoButton content description, the argument is the topic. -->
    <string name="info_more">More about %1$s</string>
    <!-- Visible close button inside InfoSheet. -->
    <string name="info_close">Close</string>
    <!-- SignalBars content description, the argument is 1 to 4. -->
    <string name="signal_bars">Signal %1$d of 4</string>
    <!-- The six air moods, one per WHO step, cleanest first, and the word for no reading. -->
    <string name="mood_fresh">Fresh air</string>
    <string name="mood_fair">Fair</string>
    <string name="mood_hazy">Getting hazy</string>
    <string name="mood_poor">Poor</string>
    <string name="mood_smoky">Smoky</string>
    <string name="mood_thick">Thick smoke</string>
    <string name="mood_none">No reading</string>
    <!-- One plain sentence per mood. Simple shows it, so it never names the guideline body. -->
    <string name="mood_fresh_line">Clean air. A good time to be outside.</string>
    <string name="mood_fair_line">Fine for most people.</string>
    <string name="mood_hazy_line">Sensitive people may notice it.</string>
    <string name="mood_poor_line">Take long outdoor effort easy.</string>
    <string name="mood_smoky_line">Stay inside if you can. A filter helps.</string>
    <string name="mood_thick_line">Stay inside with windows shut.</string>
    <string name="mood_none_line">No reading here yet.</string>
    <!-- A missing value. Never zero, never a dash. -->
    <string name="value_not_available">n/a</string>
    <!-- MoodStrip state when a block is chosen, the argument is the block word and caption. -->
    <string name="mood_strip_selected">%1$s selected</string>
    <!-- The list comma, spoken lists join with it and one space. -->
    <string name="list_separator">,</string>
    <!-- #92. The short label on every PM2.5 chart and card, saying which PM2.5 it shows. -->
    <string name="pm25_corrected">PM2.5 corrected</string>
    <string name="pm25_raw">PM2.5 raw</string>
    <!-- Behind the info icon of a PM2.5 card. -->
    <string name="pm25_correction_info">Corrected uses the US EPA humidity correction for this sensor. Raw is the sensor reading as stored. It shows when there is no humidity reading, and always in Detailed. Stored data never changes.</string>
    <!-- Quality checks of stored and live readings (#91), at the Detailed and Developer levels. -->
    <string name="qc_flagged">Flagged as suspect</string>
    <plurals name="qc_flagged_readings">
        <item quantity="one">%1$d reading flagged</item>
        <item quantity="other">%1$d readings flagged</item>
    </plurals>
    <string name="qc_pm25_above_pm10">PM2.5 is above PM10, which cannot happen.</string>
    <!-- The argument is QcRules.FLATLINE_ROWS. -->
    <string name="qc_flatline">The particle counts have not changed for %1$d readings.</string>
    <string name="qc_spike">A sudden jump that the particle counts do not show.</string>
    <!-- The argument is QcRules.HIGH_HUMIDITY_PERCENT. -->
    <string name="qc_high_humidity">Humidity is above %1$d percent, which makes the sensor read high.</string>
    <string name="qc_note">The value is shown as measured.</string>
</resources>
